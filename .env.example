# Copy this file to .env and replace the values with your actual secure passwords.
# Do NOT commit your actual .env file to GitHub.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_secure_database_password_here
POSTGRES_DB=clinic_db

# This should be a cryptographically secure string (at least 32 characters)
JWT_KEY=GenerateAStrongRandomKeyAndPasteItHereForProductionUse
